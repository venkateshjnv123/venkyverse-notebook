---
/**
 * Ambient architecture diagram for the hero. Nodes sit at fixed positions and
 * bob independently (out-of-phase so they never move in sync); one continuous
 * route glows along its edges on loop — the glow IS the pointer, no separate
 * dot. Everything here is decorative/aria-hidden; the hero's actual content
 * and links live in the text column next to this.
 */
const NODES = [
  { id: 'client',  x: 40,  y: 24,  icon: 'client',  label: 'client' },
  { id: 'gateway', x: 210, y: 96,  icon: 'gateway', label: 'gateway' },
  { id: 'metrics', x: 430, y: 40,  icon: 'metrics', label: 'metrics' },
  { id: 'service', x: 270, y: 200, icon: 'service', label: 'service' },
  { id: 'redis',   x: 70,  y: 268, icon: 'redis',   label: 'redis' },
  { id: 'worker',  x: 20,  y: 350, icon: 'worker',  label: 'worker' },
  { id: 'kafka',   x: 210, y: 396, icon: 'kafka',   label: 'kafka' },
  { id: 'postgres',x: 400, y: 340, icon: 'postgres',label: 'postgres' },
] as const;

// Static wires — drawn once, dim, never move.
const WIRES: [string, string][] = [
  ['client', 'gateway'],
  ['gateway', 'service'],
  ['gateway', 'metrics'],
  ['service', 'redis'],
  ['service', 'postgres'],
  ['redis', 'worker'],
  ['worker', 'kafka'],
  ['kafka', 'postgres'],
];

// The one continuous route the glow travels — a real request's shape:
// in through the edge, fan out to cache and disk, back out.
const ROUTE = ['client', 'gateway', 'service', 'redis', 'service', 'postgres', 'service', 'gateway', 'client'];

const byId = Object.fromEntries(NODES.map((n) => [n.id, n]));
const NW = 108, NH = 40; // node box size in viewBox units

function edgePath(aId: string, bId: string) {
  const a = byId[aId], b = byId[bId];
  return `M${a.x + NW / 2} ${a.y + NH / 2} L${b.x + NW / 2} ${b.y + NH / 2}`;
}

const routePath = ROUTE.map((id, i) => {
  const n = byId[id];
  return `${i === 0 ? 'M' : 'L'}${n.x + NW / 2} ${n.y + NH / 2}`;
}).join(' ');

const ICONS: Record<string, string> = {
  client:  '<path d="M3 4h18v11H3z"/><path d="M8 19h8"/>',
  gateway: '<path d="M4 12h6M14 12h6M10 8l4 4-4 4"/>',
  metrics: '<path d="M4 17l5-5 4 3 7-8"/>',
  service: '<rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/>',
  redis:   '<path d="M12 3l9 4-9 4-9-4 9-4z"/><path d="M3 12l9 4 9-4M3 16l9 4 9-4"/>',
  worker:  '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>',
  kafka:   '<path d="M4 8h16M4 12h16M4 16h16"/>',
  postgres:'<path d="M4 6h16v4H4z"/><path d="M4 10v8a8 2 0 0016 0v-8"/>',
};
---

<div class="nodegraph" role="img" aria-label="Diagram of a backend request travelling from client through gateway and service to cache and database">
  <svg viewBox="0 0 540 460" preserveAspectRatio="xMidYMid meet">
    <g class="wires">
      {WIRES.map(([a, b]) => <path d={edgePath(a, b)}></path>)}
    </g>

    <path class="route" d={routePath}></path>
    <path class="route-glow" d={routePath} pathLength="100"></path>

    {NODES.map((n) => (
      <g class={`node node--${n.id}`} data-node={n.id}>
        <g class="node__bob">
          <rect x={n.x} y={n.y} width={NW} height={NH} rx="3"></rect>
          <svg
            class="node__icon"
            x={n.x + 10} y={n.y + (NH - 16) / 2}
            width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round"
            set:html={ICONS[n.icon]}
          />
          <text x={n.x + 34} y={n.y + NH / 2 + 4}>{n.label}</text>
        </g>
      </g>
    ))}
  </svg>
</div>

<style>
  .nodegraph {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 540 / 460;
  }

  .nodegraph svg { display: block; width: 100%; height: 100%; overflow: visible; }

  .wires path {
    stroke: var(--color-rule);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    fill: none;
    opacity: 0.9;
  }

  /* faint base line under the glow so the route reads even between passes */
  .route {
    stroke: var(--color-green);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    fill: none;
    opacity: 0.55;
  }

  .route-glow {
    fill: none;
    stroke: var(--color-amber);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    filter: drop-shadow(0 0 4px rgba(214, 158, 46, 0.65));
    animation: travel 7s linear infinite;
  }

  @keyframes travel {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: -100; }
  }

  .node rect {
    fill: var(--color-paper-card);
    stroke: var(--color-rule);
    stroke-width: 1.3;
  }
  .node text {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    fill: var(--color-ink);
  }
  .node__icon { color: var(--color-green); }

  /* Each node bobs on its own timer/phase/amplitude so the set never
     reads as a single synchronized pulse — closer to independent vibration. */
  .node__bob { animation: bob 5s ease-in-out infinite; transform-box: fill-box; }
  .node--client  .node__bob { animation-duration: 4.6s; animation-delay: -0.2s; }
  .node--gateway .node__bob { animation-duration: 5.4s; animation-delay: -1.6s; }
  .node--metrics .node__bob { animation-duration: 6.1s; animation-delay: -3.0s; }
  .node--service .node__bob { animation-duration: 4.9s; animation-delay: -2.3s; }
  .node--redis   .node__bob { animation-duration: 5.7s; animation-delay: -0.8s; }
  .node--worker  .node__bob { animation-duration: 6.4s; animation-delay: -4.1s; }
  .node--kafka   .node__bob { animation-duration: 5.1s; animation-delay: -2.7s; }
  .node--postgres .node__bob { animation-duration: 5.9s; animation-delay: -1.1s; }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-5px); }
  }

  .route-glow { pointer-events: none; }

  @media (max-width: 800px) {
    .nodegraph { max-width: 360px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-glow { animation: none; stroke-dasharray: none; opacity: 0.85; }
    .node__bob { animation: none; }
  }
</style>
