---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---
<header class="masthead">
  <div class="masthead__inner">

    <a href="/" class="masthead__brand" aria-label="venkatesh — home">
      <span class="masthead__logo" aria-hidden="true">
        <svg viewBox="0 0 44 44" class="logo-circle">
          <circle cx="22" cy="22" r="20" fill="none"
                  stroke="currentColor" stroke-width="1.2"
                  stroke-dasharray="3 3" />
        </svg>
        <span class="masthead__mark">V</span>
      </span>
      <span class="masthead__name">venkatesh</span>
    </a>

    <span class="masthead__divider" aria-hidden="true"></span>

    <nav class="masthead__nav" aria-label="primary">
      <ul class="navpill">
        <li><a href="/"        data-num="01" class={isActive('/')        ? 'is-active' : ''}>now</a></li>
        <li><a href="/writing" data-num="02" class={isActive('/writing') ? 'is-active' : ''}>writing</a></li>
        <li><a href="/journey" data-num="03" class={isActive('/journey') ? 'is-active' : ''}>journey</a></li>
        <li><a href="/about"   data-num="04" class={isActive('/about')   ? 'is-active' : ''}>about</a></li>
        <li><a href="/life"    data-num="05" class={isActive('/life')    ? 'is-active' : ''}>life</a></li>
      </ul>
    </nav>

    {/* hidden per request — status badge read as noise
    <div class="masthead__status">
      <span class="status-dot dot--breathing"></span>
      <span class="status-text">open · SDE-2</span>
    </div>
    */}

  </div>
  <div class="masthead__rule" aria-hidden="true"></div>
</header>

<style>
.masthead {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--paper);
  backdrop-filter: blur(6px);
}

.masthead__inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1rem 1.5rem;
  max-width: 1280px;
  margin: 0 auto;
}

/* --- brand --- */
.masthead__brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: var(--green-sig);
  flex-shrink: 0;
}

.masthead__logo {
  position: relative;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  color: var(--green-sig);
  flex-shrink: 0;
}

.logo-circle {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

.masthead__mark {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1.4rem;
  font-weight: 500;
  color: var(--green-sig);
  line-height: 1;
}

.masthead__name {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 500;
  font-size: 1.5rem;
  letter-spacing: -0.01em;
}

/* --- divider --- */
.masthead__divider {
  width: 1px;
  height: 36px;
  background: rgba(15, 76, 58, 0.18);
  flex-shrink: 0;
}

/* --- caption --- */
.masthead__caption {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
  font-family: var(--font-mono);
  color: var(--coral);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  flex-shrink: 0;
}

.masthead__caption-line {
  font-size: 0.72rem;
  line-height: 1.2;
}

.masthead__caption-line--sub {
  font-size: 0.66rem;
  opacity: 0.85;
}

/* --- nav pill --- */
.masthead__nav {
  flex: 1;
  display: flex;
  justify-content: center;
}

.navpill {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0.55rem 1.5rem;
  border: 1px solid rgba(15, 76, 58, 0.25);
  border-radius: 999px;
  background: transparent;
}

.navpill li + li { margin-left: 1.5rem; }

.navpill a {
  display: inline-flex;
  align-items: baseline;
  gap: 0.35rem;
  text-decoration: none;
  position: relative;
  padding: 0.15rem 0.1rem;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1rem;
  color: var(--green-sig);
  transition: color 0.15s ease;
}

.navpill a::before {
  content: attr(data-num);
  font-family: var(--font-mono);
  font-style: normal;
  font-size: 0.72rem;
  color: var(--ink-muted);
  opacity: 0.7;
}

.navpill a:hover { color: var(--coral); }

/* active: coral dot prefix + squiggle underline */
.navpill a.is-active {
  color: var(--coral);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 8' preserveAspectRatio='none'><path d='M2 5 Q 12 1, 22 5 T 42 5 T 62 5 T 78 5' stroke='%23C4583A' stroke-width='1.4' fill='none' stroke-linecap='round'/></svg>");
  background-repeat: no-repeat;
  background-position: bottom center;
  background-size: 100% 6px;
  padding-bottom: 8px;
}

.navpill a.is-active::before {
  content: '· ' attr(data-num);
  color: var(--coral);
  opacity: 1;
}

/* --- status pill --- */
.masthead__status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.45rem 0.85rem;
  background: var(--green-soft);
  border: 1px solid rgba(15, 76, 58, 0.3);
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.04em;
  color: var(--green-sig);
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--coral);
  flex-shrink: 0;
}

.dot--breathing {
  animation: breathe 2.4s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 0.45; transform: scale(0.85); }
  50%      { opacity: 1;    transform: scale(1.1);  }
}

/* --- blue ruled line under masthead --- */
.masthead__rule {
  height: 1px;
  background: rgba(80, 110, 160, 0.35);
  width: 100%;
}

/* --- responsive --- */
@media (max-width: 1100px) {
  .masthead__caption { display: none; }
  .masthead__divider { display: none; }
}

@media (max-width: 880px) {
  .masthead__inner {
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
  }
  .masthead__nav { order: 3; flex-basis: 100%; justify-content: flex-start; }
  .navpill {
    overflow-x: auto;
    padding: 0.4rem 0.85rem;
    border-radius: 12px;
    width: 100%;
    -webkit-overflow-scrolling: touch;
  }
  .navpill li + li { margin-left: 1rem; }
  .masthead__status { font-size: 0.68rem; }
}

@media (max-width: 480px) {
  .masthead__name { font-size: 1.25rem; }
  .navpill a { font-size: 0.92rem; }
}
</style>
