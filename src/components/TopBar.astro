---
---
<div class="topbar">
  <div class="topbar-left">
    <span class="dot"></span>
    <span class="status-text">open to SDE-2 roles</span>
  </div>
  <div class="topbar-right">
    <span class="tagline-text">notebook of a backend engineer</span>
  </div>
</div>

<style>
.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 2rem;
  background: rgba(240, 237, 227, 0.9);
  backdrop-filter: blur(6px);
  border-bottom: 0.5px solid #D9D5C7;
  font-size: 11px;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8A8A82;
  font-family: var(--font-mono);
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #1F7A5E;
  animation: glow 2.4s ease-in-out infinite;
  flex-shrink: 0;
}

.status-text {
  color: #1A1A17;
  font-weight: 500;
}

.sep {
  color: #C4C0B2;
}

.topbar-right {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 12px;
  color: #4A4A45;
}

@media (max-width: 600px) {
  .topbar { padding: 10px 1rem; }
  .topbar-right { display: none; }
}
</style>
