---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalTags = [...new Set(allPosts.flatMap(p => p.data.tags))].length;
const oldestDate = allPosts.at(-1)?.data.date;
const sinceLabel = oldestDate
  ? oldestDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toLowerCase()
  : '';

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).toLowerCase();
}
---
<BaseLayout
  title="Writing · Venkatesh Patnala"
  description="Production bugs, system patterns, and engineering lessons. Notebook of a backend engineer."
  activePage="writing"
>

  <!-- Page Header -->
  <header class="archive-header">
    <div class="header-inner">
      <span class="kicker-line">
        <span class="kicker-bar"></span>
        THE NOTEBOOK · ARCHIVE
      </span>
      <h1 class="archive-h1">Everything I've written, <em>in one place.</em></h1>
      <p class="archive-desc">Production bugs, system patterns, and lessons I keep coming back to. Full version blogs here.</p>
      <div class="stats-line">
        <span>{allPosts.length} entries</span>
        <span class="stat-dot">·</span>
        <span>{totalTags} tags</span>
        <span class="stat-dot">·</span>
        <span>since {sinceLabel}</span>
      </div>
    </div>
  </header>

  <!-- All Posts -->
  <section class="cards-section">
    <div class="section-inner">
      <div class="card-grid">
        {allPosts.map(post => (
          <a href={`/writing/${post.id}`} class="card">
            <div class={`card-cover${!post.data.hero_image ? ' card-cover--placeholder' : ''}`}>
              {post.data.hero_image
                ? <img src={post.data.hero_image} alt={post.data.title} loading="lazy" />
                : <span class="card-num">№{post.data.id.padStart(3, '0')}</span>
              }
            </div>
            <div class="card-body">
              <div class="card-meta">
                {post.data.tags.map(tag => (
                  <span class={`tag-pill ${tag}`}>{tag}</span>
                ))}
                <span class="meta-sep">·</span>
                <span class="meta-text">{post.data.readTime} min</span>
                <span class="meta-sep">·</span>
                <span class="meta-text">{formatDate(post.data.date)}</span>
              </div>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-tagline">{post.data.tagline}</p>
              <span class="card-more">read <span class="card-arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── Header ────────────────────────────────────────────── */
.archive-header {
  max-width: 980px;
  margin: 0 auto;
  padding: 3rem 2rem 2rem;
}

.header-inner {
  border-bottom: 0.5px dashed #D9D5C7;
  padding-bottom: 1.5rem;
}

.kicker-line {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: #C4583A;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}

.kicker-bar {
  display: inline-block;
  width: 20px;
  height: 1.5px;
  background: #C4583A;
  flex-shrink: 0;
}

.archive-h1 {
  font-family: var(--font-serif);
  font-size: 48px;
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: #1A1A17;
  margin-bottom: 1rem;
}

.archive-h1 em {
  font-style: italic;
  color: #0F4C3A;
  position: relative;
}

.archive-h1 em::after {
  content: '';
  position: absolute;
  left: -2px; right: -2px; bottom: 4px;
  height: 10px;
  background: #D69E2E;
  opacity: 0.35;
  z-index: -1;
  border-radius: 2px;
  transform: skewX(-4deg) rotate(-0.5deg);
}

.archive-desc {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 17px;
  color: #4A4A45;
  line-height: 1.55;
  max-width: 600px;
  margin-bottom: 1rem;
}

.stats-line {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: #8A8A82;
  letter-spacing: 0.04em;
}

.stat-dot { color: #C4C0B2; }

/* ─── Section wrapper ───────────────────────────────────── */
.section-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 2rem;
}

/* ─── Card grid ─────────────────────────────────────────── */
.cards-section { padding: 2rem 0 4rem; }

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem 1.5rem;
}

.card {
  display: flex;
  flex-direction: column;
  background: #FDFCF6;
  border: 0.5px solid #D9D5C7;
  border-radius: 10px;
  overflow: hidden;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
}

.card:hover {
  transform: translateY(-3px);
  border-color: #0F4C3A;
  box-shadow: 0 1px 2px rgba(0,0,0,0.05), 0 12px 28px rgba(15,76,58,0.12);
}

.card-cover {
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--paper-deep);
  border-bottom: 0.5px solid #D9D5C7;
}

.card-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.card:hover .card-cover img { transform: scale(1.04); }

.card-cover--placeholder {
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--paper-deep), var(--green-soft));
}

.card-num {
  font-family: var(--font-mono);
  font-size: 22px;
  color: #0F4C3A;
  opacity: 0.5;
}

.card-body {
  padding: 1.25rem 1.35rem 1.4rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 0.6rem;
}

.meta-sep {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #C4C0B2;
}

.meta-text {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #8A8A82;
}

.card-title {
  font-family: var(--font-serif);
  font-size: 19px;
  font-weight: 400;
  line-height: 1.25;
  color: #1A1A17;
  margin: 0 0 0.5rem;
  transition: color 0.15s;
}

.card:hover .card-title { color: #0F4C3A; }

.card-tagline {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 14px;
  color: #4A4A45;
  line-height: 1.5;
  padding-left: 12px;
  border-left: 2px solid #D69E2E;
  margin: 0 0 1rem;
}

.card-more {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #0F4C3A;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-top: auto;
}

.card-arrow { transition: transform 0.15s; display: inline-block; }
.card:hover .card-arrow { transform: translateX(3px); }

/* ─── Responsive ────────────────────────────────────────── */
@media (max-width: 900px) {
  .card-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .archive-h1 { font-size: 32px; }
  .card-grid { grid-template-columns: 1fr; gap: 1.5rem; }
}
</style>
