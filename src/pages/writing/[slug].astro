---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Callout from '../../components/Callout.astro';
import Aside from '../../components/Aside.astro';
import Diagram from '../../components/Diagram.astro';
import Highlight from '../../components/Highlight.astro';
import Mermaid from '../../components/Mermaid.astro';

// Passed to <Content /> so posts render these components without needing an
// import line inside the .mdx. Import lines were removed from all posts so the
// Keystatic editor (which can't parse mdxjsEsm import nodes) can open them.
const mdxComponents = { Callout, Aside, Diagram, Highlight, Mermaid };

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const relatedPosts = allPosts
  .filter(p => p.id !== post.id && p.data.tags.some(t => post.data.tags.includes(t)))
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
}

const currentURL = Astro.url.href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.tagline,
  datePublished: post.data.date.toISOString(),
  url: currentURL,
  mainEntityOfPage: currentURL,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Person',
    name: 'Venkatesh Patnala',
    url: 'https://venkyverse.space',
  },
  publisher: {
    '@type': 'Person',
    name: 'Venkatesh Patnala',
    url: 'https://venkyverse.space',
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.tagline}
  ogType="article"
  canonicalURL={currentURL}
  schema={articleSchema}
>

  <!-- Reading progress bar -->
  <div class="progress" id="progress-bar">
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <!-- Article Header -->
  <header class="article-header">
    <div class="header-inner">
      <div class="post-id-line">
        <span class="post-id">№{post.data.id.padStart(3,'0')} · {formatDate(post.data.date).toUpperCase()} · {post.data.readTime} MIN READ</span>
      </div>

      <h1 class="post-h1">{post.data.title}</h1>

      <div class="post-tagline">{post.data.tagline}</div>

      <div class="post-meta-row">
        <div class="post-tags">
          {post.data.tags.map(tag => (
            <span class={`tag-pill ${tag}`}>{tag}</span>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article class="article-wrap">
    <div class="article">
      <Content components={mdxComponents} />
    </div>
  </article>

  <!-- Article Footer -->
  <footer class="article-footer">
    <div class="footer-inner-post">

      <!-- LinkedIn CTA -->
      <div class="li-cta">
        <p class="li-cta-text">Liked this? I cross-post everything I write to LinkedIn. Follow for the next one.</p>
        <a
          href="https://www.linkedin.com/in/venkatesh-patnala-927a521b0"
          target="_blank"
          rel="noopener noreferrer"
          class="li-cta-btn"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
          follow on linkedin
        </a>
      </div>

      <!-- Related posts -->
      {relatedPosts.length > 0 && (
        <div class="related-card">
          <div class="related-head">
            <span class="related-kicker">~/related</span>
            <h4 class="related-heading">
              More on <em>{post.data.tags[0]}</em>
            </h4>
          </div>
          <div class="related-grid">
            {relatedPosts.map(rp => (
              <a href={`/writing/${rp.id}`} class="related-item">
                <div class={`related-cover${!rp.data.hero_image ? ' related-cover--ph' : ''}`}>
                  {rp.data.hero_image
                    ? <img src={rp.data.hero_image} alt={rp.data.title} loading="lazy" />
                    : <span>№{rp.data.id.padStart(3,'0')}</span>
                  }
                </div>
                <div class="related-body">
                  <span class="related-num"><span class="num-sign-green">№</span>{rp.data.id.padStart(3,'0')} · {rp.data.readTime} min</span>
                  <span class="related-title">{rp.data.title}</span>
                </div>
                <span class="related-arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </footer>

</BaseLayout>

<style>
/* ─── Progress bar ──────────────────────────────────────── */
.progress {
  position: sticky;
  top: 38px;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(15, 76, 58, 0.08);
  z-index: 99;
}

.progress-fill {
  height: 100%;
  background: #0F4C3A;
  width: 0%;
  transition: width 0.1s ease-out;
}

/* ─── Breadcrumbs ───────────────────────────────────────── */
.breadcrumbs-wrap {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 2rem 0;
}

.breadcrumbs {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #8A8A82;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
}

.bc-link {
  color: #4A4A45;
  transition: color 0.15s;
}
.bc-link:hover { color: #0F4C3A; }

.bc-sep {
  color: #C4C0B2;
  margin: 0 8px;
}

.bc-current {
  color: #0F4C3A;
  font-weight: 500;
}

/* ─── Article Header ────────────────────────────────────── */
.article-header {
  max-width: 720px;
  margin: 0 auto;
}

.header-inner {
  padding: 1.5rem 2rem 2rem;
  border-bottom: 0.5px dashed #D9D5C7;
}

.post-id-line {
  margin-bottom: 1rem;
}

.post-id {
  font-family: var(--font-mono);
  font-size: 12px;
  color: #C4583A;
  letter-spacing: 0.08em;
  font-weight: 500;
}

.post-id::before {
  content: '';
  display: inline-block;
  width: 20px;
  height: 1.5px;
  background: #C4583A;
  margin-right: 10px;
  vertical-align: middle;
}

.post-h1 {
  font-family: var(--font-serif);
  font-size: 42px;
  font-weight: 400;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #1A1A17;
  margin-bottom: 1.25rem;
}

.post-tagline {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 18px;
  color: #4A4A45;
  line-height: 1.45;
  padding-left: 16px;
  border-left: 3px solid #D69E2E;
  margin-bottom: 2rem;
}

.post-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.author-block {
  display: flex;
  align-items: center;
  gap: 10px;
}

.author-avatar {
  position: relative;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1.5px solid #1A1A17;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.author-avatar::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1px dashed #0F4C3A;
  opacity: 0.4;
}

.avatar-v {
  font-family: var(--font-serif);
  font-style: italic;
  color: #0F4C3A;
  font-size: 15px;
}

.author-name {
  font-size: 13px;
  font-weight: 500;
  color: #1A1A17;
}

.author-sub {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 12px;
  color: #8A8A82;
}

.post-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

/* ─── Article Body ──────────────────────────────────────── */
.article-wrap {
  max-width: 720px;
  margin: 0 auto;
}

.article {
  font-family: var(--font-serif);
  font-size: 18px;
  line-height: 1.7;
  color: #1A1A17;
  padding: 2rem 2rem 3rem;
}

.article :global(p) { margin-bottom: 1.5rem; }

.article :global(a) {
  color: #0F4C3A;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
}

.article :global(strong) {
  font-weight: 500;
  color: #0F4C3A;
}

.article :global(em) {
  font-style: italic;
  color: #4A4A45;
}

.article :global(ul),
.article :global(ol) {
  margin: 0 0 1.5rem 1.5rem;
  padding-left: 0.5rem;
}

.article :global(li) { margin-bottom: 0.5rem; }

.article :global(h2) {
  font-family: var(--font-serif);
  font-size: 26px;
  font-weight: 500;
  line-height: 1.3;
  letter-spacing: -0.01em;
  margin: 2.5rem 0 1rem;
}

.article :global(h2 em) {
  font-style: italic;
  color: #0F4C3A;
}

.article :global(h3) {
  font-family: var(--font-serif);
  font-size: 20px;
  font-weight: 500;
  margin: 1.75rem 0 0.75rem;
}

/* Keep post media inside the reading column on every screen size. */
.article :global(img) {
  display: block;
  max-width: 100%;
  height: auto;
}

/* Inline code */
.article :global(code:not([class*="language"])) {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: #FDF3D9;
  color: #A17617;
  padding: 1px 6px;
  border-radius: 3px;
  border-bottom: 1px solid rgba(214, 158, 46, 0.3);
}

/* Code blocks */
.article :global(pre) {
  background: #1A1A17;
  border-radius: 8px;
  padding: 1rem 1.25rem;
  margin: 1.5rem 0;
  overflow-x: auto;
}

.article :global(pre code) {
  font-family: var(--font-mono);
  font-size: 13px;
  color: #F7F5EE;
  line-height: 1.6;
  background: none;
  border: none;
  padding: 0;
}

/* ─── Article Footer ────────────────────────────────────── */
.article-footer {
  max-width: 720px;
  margin: 0 auto;
}

.footer-inner-post {
  padding: 2rem;
  border-top: 0.5px dashed #D9D5C7;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* LinkedIn CTA */
.li-cta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 1.25rem 1.5rem;
  background: #0F4C3A;
  color: #F7F5EE;
  border-radius: 10px;
}

.li-cta-text {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 15px;
  line-height: 1.45;
  max-width: 360px;
  margin: 0;
}

.li-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 16px;
  background: #F7F5EE;
  color: #0F4C3A;
  border-radius: 6px;
  font-family: var(--font-mono);
  font-size: 12px;
  font-weight: 500;
  white-space: nowrap;
  transition: all 0.15s;
}

.li-cta-btn:hover {
  background: #D69E2E;
  color: #1A1A17;
}

/* Related posts */
.related-card {
  background: linear-gradient(160deg, #F0EDE3, #E9E5D8);
  border: 0.5px solid #D9D5C7;
  border-radius: 14px;
  padding: 1.75rem 1.5rem;
}

.related-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1.25rem;
  gap: 1rem;
}

.related-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #8A8A82;
  letter-spacing: 0.08em;
}

.related-heading {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  color: #1A1A17;
  margin: 0;
}

.related-heading em {
  font-style: italic;
  color: #0F4C3A;
}

.related-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.related-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 12px;
  background: #FDFCF6;
  border: 0.5px solid transparent;
  border-radius: 10px;
  transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
}

.related-item:hover {
  transform: translateX(3px);
  border-color: #0F4C3A;
  box-shadow: 0 4px 14px rgba(15,76,58,0.1);
}
.related-item:hover .related-title { color: #0F4C3A; }
.related-item:hover .related-arrow { transform: translateX(3px); color: #0F4C3A; }

.related-cover {
  width: 68px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 6px;
  overflow: hidden;
  background: var(--paper-deep);
  border: 0.5px solid #D9D5C7;
}

.related-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.related-cover--ph {
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--paper-deep), var(--green-soft));
  font-family: var(--font-mono);
  font-size: 11px;
  color: #0F4C3A;
}

.related-body {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
  min-width: 0;
}

.related-num {
  font-family: var(--font-mono);
  font-size: 10px;
  color: #8A8A82;
  white-space: nowrap;
}

.num-sign-green { color: #0F4C3A; }

.related-title {
  font-family: var(--font-serif);
  font-size: 15px;
  color: #1A1A17;
  line-height: 1.3;
  transition: color 0.15s;
}

.related-arrow {
  font-family: var(--font-mono);
  font-size: 15px;
  color: #8A8A82;
  flex-shrink: 0;
  transition: transform 0.15s, color 0.15s;
}

/* ─── Responsive ────────────────────────────────────────── */
@media (max-width: 700px) {
  .post-h1 { font-size: 30px; }
  .article { font-size: 17px; }
  .article :global(h2) { font-size: 22px; }
  .post-meta-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .li-cta { flex-direction: column; align-items: flex-start; }
  .breadcrumbs { font-size: 10px; }
}
</style>

<script>
// Reading progress bar
const progressFill = document.getElementById('progress-fill');

function updateProgress() {
  if (!progressFill) return;
  const scrollTop = window.scrollY;
  const docHeight = document.documentElement.scrollHeight - window.innerHeight;
  const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
  progressFill.style.width = `${Math.min(pct, 100)}%`;
}

let ticking = false;
window.addEventListener('scroll', () => {
  if (!ticking) {
    requestAnimationFrame(() => {
      updateProgress();
      ticking = false;
    });
    ticking = true;
  }
});
</script>
