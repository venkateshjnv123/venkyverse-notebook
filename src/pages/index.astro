---
import BaseLayout from '../layouts/BaseLayout.astro';
import NodeGraph from '../components/NodeGraph.astro';
import IllustrationFrame from '../components/IllustrationFrame.astro';
// import BookIntro from '../components/BookIntro.astro'; // opening animation paused
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---
<BaseLayout>

  {/* ── SECTION 0: OPENING ANIMATION — paused for now ──────
  <BookIntro />
  */}

  <!-- ── SECTION 3: HERO ─────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-left">
        <h1 class="hero-h1">
          Building backend systems <span class="hero-aside">(of course with AI)</span><br>
          that <em>(don't) break at scale.</em>
        </h1>
        <p class="hero-sub">
          I'm Venkatesh Patnala — a backend engineer always thinking in tradeoffs, shipping alongside
          AI, and writing down what I learn along the way. Currently at Cars24.
        </p>
        {/* hidden per request — CTAs paused
        <div class="hero-ctas">
          <a href="#currently" class="btn-primary">see what I'm building →</a>
          <a href="#about" class="btn-ghost">or read the long version</a>
        </div>
        */}
        {/* hidden per request — "in the lab" feature not needed
        <a href="#currently" class="scroll-hint">
          <span>in the lab</span>
          <span class="arrow">↓</span>
        </a>
        */}
      </div>
      <div class="hero-right">
        <IllustrationFrame />
        <div class="hero-socials">
          <a href="https://github.com/venkateshjnv123" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.185 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.342-3.369-1.342-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.087.636-1.337-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.202 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482C19.138 20.203 22 16.447 22 12.021 22 6.484 17.523 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>
          <a href="https://www.linkedin.com/in/venkatesh-patnala-927a521b0/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 4: ARCHITECTURE GRAPH ──────────────────── -->
  <section class="graph-frame">
    <div class="graph-inner">
      <NodeGraph />
    </div>
  </section>

  <!-- ── SECTION 5: TIMELINE ────────────────────────────── -->
  <section class="path-section" id="path">
    <div class="path-inner">
      <span class="kicker">THE PATH SO FAR</span>
      <h2 class="section-h2">From IIT Jodhpur to <em>Engineering.</em></h2>

      <div class="timeline">
        <div class="timeline-node">
          <div class="dot dot-default"></div>
          <div class="node-text">
            <div class="node-year">2019 — 2023</div>
            <div class="node-role">B.Tech, Mechanical Engg</div>
            <div class="node-where">IIT Jodhpur</div>
          </div>
        </div>
        <div class="timeline-node">
          <div class="dot dot-default"></div>
          <div class="node-text">
            <div class="node-year">Aug 2023 — Mar 2025</div>
            <div class="node-role">Software Engineer</div>
            <div class="node-where">Cogoport · Sprinklr</div>
          </div>
        </div>
        <div class="timeline-node">
          <div class="dot dot-active"></div>
          <div class="node-text">
            <div class="node-year">Apr 2025 — now</div>
            <div class="node-role">Builder: Backend engineering</div>
            <div class="node-where">Cars24 · payment &amp; C2C systems</div>
          </div>
        </div>
        <div class="timeline-node">
          <div class="dot dot-future"></div>
          <div class="node-text">
            <div class="node-year">What's next</div>
            <div class="node-role">SDE-2</div>
            <div class="node-where">Building at deeper scale</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 6: MY NOTEBOOK ─────────────────────────── -->
  <section class="notebook-section">
    <div class="notebook-inner">
      <span class="kicker">MY NOTEBOOK</span>
      <h2 class="section-h2">My backend stories and what they <em>taught me.</em></h2>
      {/* hidden per request
      <p class="notebook-desc">Production bugs become patterns become lessons. Short version here. Full version on LinkedIn.</p>
      */}

      <div class="post-list">
        {posts.map((post) => (
          <a
            href={`/writing/${post.id}`}
            class="post-row"
            data-tags={post.data.tags.join(' ')}
          >
            <div class="post-num">
              <span class="num-sign">№</span>{post.data.id.padStart(3, '0')}
            </div>
            <div class="post-body">
              <div class="post-meta">
                {post.data.tags.map(tag => (
                  <span class={`tag-pill ${tag}`}>{tag}</span>
                ))}
                <span class="post-meta-sep">·</span>
                <span class="post-meta-time">{post.data.readTime} min</span>
                <span class="post-meta-sep">·</span>
                <span class="post-meta-date">{formatDate(post.data.date)}</span>
              </div>
              <div class="post-title">{post.data.title}</div>
              <div class="post-lesson">{post.data.tagline}</div>
            </div>
            <div class="post-arrow">→</div>
          </a>
        ))}
      </div>

      <div class="archive-link-wrap">
        <a href="/writing" class="archive-link">view full archive →</a>
      </div>
    </div>
  </section>

  <!-- ── SECTION 7: ABOUT + LIFE ────────────────────────── -->
  <section class="twocol-section" id="about">
    <div class="twocol-inner twocol">
      <div class="about-col">
        <span class="kicker">ABOUT THE AUTHOR</span>

        <p class="about-p">
          I graduated from <strong>IIT Jodhpur in 2023</strong>, interned at Aspiro, shipped my first
          production services at Cogoport, wrote automation at Sprinklr, and now build backend systems
          at <span class="hl">Cars24</span>.
        </p>
        <p class="about-p">
          Two questions I ask myself: <em>how do you design systems that break gracefully under
          chaos</em>, and <em>how best can I use AI so it multiplies my work instead of breaking
          it</em>. Almost everything I write is either AI or breaking production.
        </p>
        <p class="about-p">
          I also read more than I probably should, travel when I can, and write down what I'm thinking
          about in <a href="/life" class="gu">the /life section</a>. Because this site should feel like
          a real person maintains it.
        </p>

        <div class="signature">
          <div class="sig-name">— v.</div>
          <div class="sig-place">apr 2026</div>
        </div>
      </div>

      <div class="life-col">
        <div class="life-card">
          <h3 class="life-heading">Beyond the <em>IDE.</em></h3>
          <div class="life-items">
            <a href="/life/trips" class="life-item">
              <div class="life-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a8 8 0 0 0-8 8c0 5.5 8 12 8 12s8-6.5 8-12a8 8 0 0 0-8-8z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div class="life-item-text">
                <div class="life-item-name">Trips &amp; travel notes</div>
                <div class="life-item-meta">4 journeys · latest: Spiti</div>
              </div>
            </a>
            <a href="/life/books" class="life-item">
              <div class="life-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
              </div>
              <div class="life-item-text">
                <div class="life-item-name">Book reviews</div>
                <div class="life-item-meta">12 books · tech · fiction · biography</div>
              </div>
            </a>
            <a href="/life/movies" class="life-item">
              <div class="life-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="18" rx="2"/>
                  <path d="M8 3v18M16 3v18M2 9h4M2 15h4M18 9h4M18 15h4"/>
                </svg>
              </div>
              <div class="life-item-text">
                <div class="life-item-name">Movie reviews</div>
                <div class="life-item-meta">8 films · short takes</div>
              </div>
            </a>
            <div class="life-item life-item-static">
              <div class="life-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              </div>
              <div class="life-item-text">
                <div class="life-item-name">Currently reading</div>
                <div class="life-item-meta"><em class="reading-title">Zero to One</em> · Peter Thiel</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION 8: CTA CARD ────────────────────────────── -->
  <section class="cta-section">
    <div class="cta-inner">
      <div class="cta-card">
        <div class="cta-left">
          <span class="cta-kicker">IF YOU'RE HIRING OR JUST CURIOUS</span>
          <h2 class="cta-heading">Let's talk AI. <em>Or anything else.</em></h2>
          <p class="cta-para">
            I'm open to software roles where systems thinking matters and AI is a tool, not a threat.
            Also genuinely happy to talk to engineers working on interesting backend problems — hiring or not.
          </p>
        </div>
        <div class="cta-right">
          <a href="mailto:venkateshjnv123@gmail.com" class="cta-btn-primary">email me →</a>
          <a
            href="https://www.linkedin.com/in/venkatesh-patnala-927a521b0"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-btn-secondary"
          >follow on linkedin</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ─── HERO ──────────────────────────────────────────────── */
.hero {
  max-width: 980px;
  margin: 0 auto;
  padding: 5rem 2rem;
  min-height: calc(100vh - 60px);
  display: flex;
  align-items: center;
}

@media (max-height: 700px) {
  .hero { min-height: auto; padding: 4rem 2rem 3rem; }
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 4rem;
  align-items: center;
  width: 100%;
}

.hero-left {
  display: flex;
  flex-direction: column;
}

.hero-right {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 1.5rem;
}

.hero-socials {
  display: flex;
  gap: 1rem;
}

.social-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: #8A8A82;
  padding: 6px 12px;
  border: 0.5px solid #D9D5C7;
  border-radius: 4px;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
}

.social-link:hover {
  color: #0F4C3A;
  border-color: #0F4C3A;
}

.social-link svg {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.hero-h1 {
  font-family: var(--font-serif);
  font-size: clamp(32px, 4vw, 54px);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: #1A1A17;
  margin-bottom: 1.5rem;
}

.hero-h1 em {
  font-style: italic;
  color: #0F4C3A;
  position: relative;
}

.hero-h1 em::after {
  content: '';
  position: absolute;
  left: -2px;
  right: -2px;
  bottom: 4px;
  height: 10px;
  background: #D69E2E;
  opacity: 0.35;
  z-index: -1;
  border-radius: 2px;
  transform: skewX(-4deg) rotate(-0.5deg);
}

/* parenthetical in the headline — drops to body size so it reads as an
   inline aside rather than part of the heading */
.hero-aside {
  font-family: var(--font-serif);
  font-size: clamp(14px, 1vw, 16px);
  font-style: italic;
  letter-spacing: 0;
  color: #8A8A82;
  white-space: nowrap;
}

.hero-sub {
  font-size: clamp(15px, 1.1vw, 17px);
  line-height: 1.7;
  color: #4A4A45;
  max-width: 560px;
  margin-bottom: 2rem;
}

.hero-ctas {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.btn-primary {
  display: inline-block;
  padding: 11px 20px;
  background: #1A1A17;
  color: #F7F5EE;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  transition: background 0.15s;
}
.btn-primary:hover { background: #0F4C3A; }

.btn-ghost {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 15px;
  color: #8A8A82;
  text-decoration: underline;
  transition: color 0.15s;
}
.btn-ghost:hover { color: #0F4C3A; }

.scroll-hint {
  margin-top: 3rem;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 14px;
  color: #8A8A82;
  cursor: pointer;
  text-decoration: none;
  transition: color 0.2s;
  align-self: flex-start;
}
.scroll-hint:hover { color: #0F4C3A; }
.scroll-hint .arrow {
  font-size: 16px;
  animation: gentleBob 2s ease-in-out infinite;
}
@keyframes gentleBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(3px); }
}

/* ─── TIMELINE ──────────────────────────────────────────── */
.path-section {
  border-top: 0.5px dashed #D9D5C7;
  padding-top: 5rem;
}

.path-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 2rem;
}

.timeline {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  position: relative;
  max-width: 900px;
  margin: 0 auto;
}

.timeline::before {
  content: '';
  position: absolute;
  top: 7px;
  left: 7px;
  right: 7px;
  height: 0.5px;
  background: #D9D5C7;
  z-index: 0;
}

.timeline-node {
  position: relative;
  z-index: 1;
}

.dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
}

.dot-default {
  background: #F7F5EE;
  border: 1.5px solid #8A8A82;
}

.dot-active {
  background: #C4583A;
  border: 1.5px solid #C4583A;
  box-shadow: 0 0 0 4px rgba(196, 88, 58, 0.15);
}

.dot-future {
  background: transparent;
  border: 1.5px dashed #8A8A82;
}

.node-text { margin-top: 1rem; }

.node-year {
  font-family: var(--font-mono);
  font-size: 13px;
  color: #8A8A82;
  margin-bottom: 6px;
}

.node-role {
  font-size: 17px;
  font-weight: 500;
  color: #1A1A17;
  margin-bottom: 4px;
  line-height: 1.3;
}

.node-where {
  font-size: 14px;
  color: #4A4A45;
  line-height: 1.4;
}

/* ─── ARCHITECTURE GRAPH ────────────────────────────────── */
.graph-frame { padding: 2rem 0 5rem; }

.graph-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 2rem;
  display: flex;
  justify-content: center;
}

/* ─── NOTEBOOK ──────────────────────────────────────────── */
.notebook-section { padding: 4rem 0 0; }

.notebook-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 2rem 4rem;
}

.notebook-desc {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 15px;
  color: #4A4A45;
  max-width: 600px;
  line-height: 1.55;
}


.post-row {
  display: grid;
  grid-template-columns: 60px 1fr auto;
  gap: 1.5rem;
  padding: 1.5rem 0;
  border-bottom: 0.5px dashed #D9D5C7;
  cursor: pointer;
  transition: all 0.15s;
  align-items: start;
}

.post-row:hover .post-title { color: #0F4C3A; }
.post-row:hover .post-arrow { color: #0F4C3A; transform: translateX(3px); }

.post-num {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #8A8A82;
  padding-top: 6px;
}

.num-sign { color: #0F4C3A; }

.post-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
  margin-bottom: 6px;
}

.post-meta-sep {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #C4C0B2;
}

.post-meta-time,
.post-meta-date {
  font-family: var(--font-mono);
  font-size: 11px;
  color: #8A8A82;
}

.post-title {
  font-family: var(--font-serif);
  font-size: 21px;
  font-weight: 400;
  line-height: 1.25;
  color: #1A1A17;
  transition: color 0.15s;
}

.post-lesson {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 14px;
  color: #4A4A45;
  padding-left: 12px;
  border-left: 2px solid #D69E2E;
  margin-top: 6px;
  line-height: 1.5;
}

.post-arrow {
  font-family: var(--font-mono);
  font-size: 18px;
  color: #8A8A82;
  padding-top: 14px;
  transition: all 0.15s;
}

.archive-link-wrap {
  margin-top: 1.5rem;
  text-align: center;
}

.archive-link {
  font-family: var(--font-mono);
  font-size: 12px;
  color: #0F4C3A;
  font-weight: 500;
  border-bottom: 1px solid currentColor;
  padding-bottom: 1px;
  transition: opacity 0.15s;
}
.archive-link:hover { opacity: 0.7; }

/* ─── ABOUT + LIFE ──────────────────────────────────────── */
.twocol-section { padding: 4rem 0 1rem; }

.twocol-inner {
  max-width: 980px;
  margin: 0 auto;
  padding: 0 2rem;
}

.twocol {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 3rem;
}

.about-p {
  font-size: 15px;
  line-height: 1.65;
  color: #1A1A17;
  margin-bottom: 1rem;
}

.about-p strong { font-weight: 500; }
.about-p em { font-style: italic; }

.signature { margin-top: 2rem; }

.sig-name {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 17px;
  color: #0F4C3A;
}

.sig-place {
  font-family: var(--font-mono);
  font-size: 12px;
  color: #8A8A82;
  margin-top: 2px;
}

.life-card {
  background: #F0EDE3;
  border: 0.5px solid #D9D5C7;
  border-radius: 10px;
  padding: 1.5rem;
  position: relative;
}

.life-card::before {
  content: '~/life';
  position: absolute;
  top: 12px;
  right: 14px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: #8A8A82;
  letter-spacing: 0.04em;
}

.life-heading {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  color: #1A1A17;
  margin-bottom: 1rem;
}

.life-heading em {
  font-style: italic;
  color: #0F4C3A;
}

.life-items {
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}

.life-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 12px;
  background: #F7F5EE;
  border: 0.5px solid transparent;
  border-radius: 8px;
  cursor: pointer;
  transition: border-color 0.15s;
}

